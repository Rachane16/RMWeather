{
  "version": 8,
  "name": "ELEMNT Natural Terrain · RMWeather",
  "metadata": {
    "elemnt:variant": "light",
    "elemnt:schema": "elemnt-osm (Protomaps-derived, type in kind; water areas carry kind_detail)",
    "elemnt:author": "elemnt-cartographer",
    "elemnt:palette": "Topographic (generated from palette.json; every ground colour is a deliberate token, not copied from the house template)",
    "elemnt:note": "Generated by scripts/gen-style.mjs. Road hierarchy reads from width + casing (not hue), so it survives CVD and grayscale. Edit palette.json then regenerate; do not hand-edit colours.",
    "elemnt:addon": {
      "feature": "terrain",
      "hillshade": true,
      "terrain3d": true,
      "buildings3d": true,
      "sky": true,
      "demUrl": "pmtiles://https://s3-public.elemnt.earth/elemnt-opendata/ELEVATION/elevation-lastest.pmtiles",
      "encoding": "terrarium",
      "tileSize": 512,
      "exaggeration": 1.2,
      "note": "Generated by scripts/add-terrain.mjs (opt-in). Verify DEM encoding with pmtiles show before shipping."
    },
    "rmweather:derived-from": "https://carto.elemnt.earth/2026-06-24_topographic/style.json"
  },
  "glyphs": "https://s3-public.elemnt.earth/elemnt-opendata/styles/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://s3-public.elemnt.earth/elemnt-opendata/styles/sprites/v4/light",
  "sources": {
    "osm": {
      "type": "vector",
